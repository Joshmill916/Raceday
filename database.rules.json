{
  "rules": {
    "tracks": {
      "$key": {
        ".read": true,
        ".write": "auth != null && root.child('trackStaff').child($key).child(auth.uid).exists()"
      }
    },
    "trackOwner": {
      "$key": {
        ".read": true,
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
        ".validate": "newData.isString()"
      }
    },
    "trackStaff": {
      "$key": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && ((auth.uid === $uid && newData.exists() && (root.child('trackOwner').child($key).val() === auth.uid || newData.val() === root.child('trackInvite').child($key).val())) || (!newData.exists() && root.child('trackStaff').child($key).child(auth.uid).exists()))",
          ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
        }
      }
    },
    "trackInvite": {
      "$key": {
        ".read": false,
        ".write": "auth != null && root.child('trackStaff').child($key).child(auth.uid).exists()",
        ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
      }
    },
    "trackPin": {
      "$key": {
        ".read": "auth != null && root.child('trackStaff').child($key).child(auth.uid).exists()",
        ".write": "auth != null && root.child('trackStaff').child($key).child(auth.uid).exists()",
        ".validate": "newData.isString() && newData.val().length <= 128"
      }
    },
    "profiles": {
      "$id": {
        "card": {
          ".read": true,
          ".write": true,
          ".validate": "newData.hasChildren(['name','num','updatedAt'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "num": { ".validate": "newData.isString() && newData.val().length <= 8" },
          "age": { ".validate": "newData.isString() && newData.val().length <= 8" },
          "hometown": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "sponsors": { ".validate": "newData.isString() && newData.val().length <= 160" },
          "teamColor": { ".validate": "newData.isString() && newData.val().length <= 7" },
          "teamColor2": { ".validate": "newData.isString() && newData.val().length <= 7" },
          "teamColor3": { ".validate": "newData.isString() && newData.val().length <= 7" },
          "photo": { ".validate": "newData.isString() && newData.val().length <= 80000" },
          "premiumCode": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "aliases": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "bio": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "highlights": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "crew": { ".validate": "newData.isString() && newData.val().length <= 160" },
          "header": { ".validate": "newData.isString() && newData.val().length <= 140000" },
          "other": { ".validate": "newData.isString() && newData.val().length <= 8000" },
          "rides": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "rideLabel": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "entitlement": {
          ".read": true,
          ".write": false
        }
      }
    },
    "profiles_short": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "newData.isString() && newData.val().matches(/^prof_[a-z0-9]{6,20}$/i)"
      }
    },
    "codeGrants": {
      "$sessionId": {
        ".read": true,
        ".write": false
      }
    },
    "results": {
      "$trackId": {
        ".read": true,
        "$date": {
          "$className": {
            "$driverKey": {
              ".read": true,
              ".write": "auth != null && root.child('resultsWriter').child($trackId).child(auth.uid).exists()",
              ".validate": "newData.hasChildren(['profileId','name','num','position'])",
              "profileId": { ".validate": "newData.isString() && newData.val().matches(/^prof_[a-z0-9]{6,20}$/i)" },
              "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "num": { ".validate": "newData.isString() && newData.val().length <= 8" },
              "position": { ".validate": "newData.isNumber()" },
              "points": { ".validate": "newData.isNumber()" },
              "trackName": { ".validate": "newData.isString() && newData.val().length <= 60" },
              "$other": { ".validate": false }
            }
          }
        }
      }
    },
    "profileTracks": {
      "$profileId": {
        ".read": true,
        "$trackId": {
          ".read": true,
          ".write": "auth != null && root.child('resultsWriter').child($trackId).child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['trackName'])",
          "trackName": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "lastSeen": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "resultsKey": {
      "$trackId": {
        ".read": false,
        ".write": "auth != null && (!data.exists() || root.child('resultsWriter').child($trackId).child(auth.uid).exists())",
        ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
      }
    },
    "resultsWriter": {
      "$trackId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && newData.exists() && newData.val() === root.child('resultsKey').child($trackId).val()",
          ".validate": "newData.isString()"
        }
      }
    },
    "subscriptions": {
      "$subId": {
        ".read": false,
        ".write": false
      }
    },
    "trackBackups": {
      "$trackId": {
        ".read": false,
        "latest": {
          ".write": true,
          ".validate": "newData.hasChildren(['at','data'])",
          "at": { ".validate": "newData.isNumber()" },
          "trackName": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "schemaVersion": { ".validate": "newData.isNumber()" },
          "data": { ".validate": "newData.isString() && newData.val().length <= 5000000" },
          "$other": { ".validate": false }
        },
        "daily": {
          "$date": {
            ".write": true,
            ".validate": "newData.hasChildren(['at','data'])",
            "at": { ".validate": "newData.isNumber()" },
            "trackName": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "schemaVersion": { ".validate": "newData.isNumber()" },
            "data": { ".validate": "newData.isString() && newData.val().length <= 5000000" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "restores": {
      "$code": {
        ".read": true,
        ".write": false
      }
    },
    "backupTracks": {
      "$trackId": {
        ".read": false,
        ".write": true,
        ".validate": "newData.isBoolean()"
      }
    }
  }
}
